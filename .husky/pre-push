#!/bin/sh

echo "⏳ Running pre-push checks..."

echo "→ TypeScript..."
pnpm typecheck || exit 1

echo "→ Lint..."
pnpm lint || exit 1

# Coverage runs here rather than as a separate script nobody remembers to run.
# An unenforced gate is not a gate. There is no remote CI on this repo, so this
# hook is the only thing standing between a coverage regression and main.
echo "→ Tests + coverage thresholds..."
pnpm test:coverage || exit 1

echo "✅ All checks passed"
